#!/bin/sh
# Nova TUI launcher: starts the OpenTUI (TypeScript) client, which auto-spawns the Python backend.
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
export NOVA_PROJECT_ROOT="${NOVA_PROJECT_ROOT:-$PROJECT_ROOT}"
export NOVA_TUI_BACKEND="${NOVA_TUI_BACKEND:-1}"
export NOVA_WORKSPACE_DIR="${NOVA_WORKSPACE_DIR:-$(pwd)}"
cd "$PROJECT_ROOT/tui" || exit 1
if [ -f dist/index.js ]; then
    exec bun dist/index.js
fi
echo "Nova TUI bundle not found at tui/dist/index.js; run 'bun install && bun run build'. Falling back to source." >&2
exec bun run src/index.tsx
