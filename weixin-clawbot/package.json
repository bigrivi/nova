{
  "name": "nova-weixin-clawbot-bridge",
  "version": "0.1.0",
  "description": "Bridge WeChat ClawBot to a Nova server over the chat SSE stream",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build && node dist/src/main.js",
    "login": "npm run build && node dist/src/login.js",
    "smoke": "npm run build && node dist/tests/smoke.js",
    "approval": "npm run build && node dist/tests/approval-live.js"
  },
  "dependencies": {
    "weixin-agent-sdk": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}